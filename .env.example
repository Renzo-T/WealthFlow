# Optional. WealthFlow asks for your Plaid keys on first run and keeps them, with an encryption key it creates, in
# config.json in its data folder. Values here (or real environment variables) override that, e.g. for development.
# Plaid dashboard > Developers > Keys. Sandbox and Production use DIFFERENT secrets.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=                   # sandbox | production (set here, it overrides the choice made in the app)
# Only for the embedded Link fallback (Hosted Link needs none): must match an Allowed redirect URI in the Plaid
# dashboard, and Production needs https (certs/localhost.pem + certs/localhost-key.pem, e.g. from mkcert).
PLAID_REDIRECT_URI=
# 64 hex characters. Leave empty to use the one in config.json.
ENCRYPTION_KEY=
# Where the database, backups and config.json live (default: data/, or your app-data folder for the download).
WEALTHFLOW_DATA_DIR=

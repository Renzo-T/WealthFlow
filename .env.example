# Plaid dashboard > Developers > Keys. Sandbox and Production use DIFFERENT secrets.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox            # sandbox | production
# Must match an entry in Dashboard > Team Settings > API > Allowed redirect URIs.
# Production requires https (see README, mkcert). Sandbox may use http.
PLAID_REDIRECT_URI=http://localhost:3000/oauth
# 32 bytes hex: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

      "css": ":host{--rail:#1e2a47;--rail-2:#2b3b63;--rail-ink:#c5ccdd;--blue:#2d4a93;--soft:#e8ecf5;--bg:#f3f3ef;--dot:#d6d9d3;--card:#fff;--surface-2:#f7f7f4;--line:#e1e3df;--line-strong:#c8ccd2;--ink:#1b2030;--muted:#555c6e;--hub:#475066;--ink-dot:#26355c;--green:#24724f;--red:#b4382a;--seal:#d9482e;--seal-ink:#fff6f2;font-family:\"Atkinson Hyperlegible Next\",\"Segoe UI\",system-ui,sans-serif;font-variant-numeric:tabular-nums;color:var(--ink)} .ds-btn-primary{font:inherit;font-weight:700;padding:.5rem .95rem;border-radius:6px;border:1px solid var(--rail);background:var(--rail);color:#fff;cursor:pointer;transition:background-color .15s,border-color .15s}.ds-btn-primary:hover{background:var(--rail-2);border-color:var(--rail-2)}.ds-btn-primary:focus-visible{outline:2px solid var(--blue);outline-offset:2px}.ds-btn-primary:active{transform:translateY(1px)}"

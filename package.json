{
  "name": "wealthflow",
  "version": "0.1.2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Renzo-T/WealthFlow"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npm run dev",
    "dev": "concurrently -n api,web \"node --watch server/index.js\" \"vite web\"",
    "server": "node server/index.js",
    "app": "node scripts/app.mjs",
    "build": "vite build web",
    "package": "node scripts/package.mjs",
    "release": "node scripts/release.mjs",
    "test": "node --test \"tests/*.test.js\"",
    "check:ui": "node scripts/check-ui.mjs",
    "verify": "node scripts/verify.mjs",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "plaid": "latest"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^8.2.2",
    "d3-sankey": "^0.12.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-plaid-link": "^4.0.1",
    "vite": "^8.3.1"
  },
  "engines": {
    "node": ">=22.13"
  }
}

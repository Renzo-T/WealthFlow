{
  "name": "wealthflow",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.js",
    "start": "npm run dev",
    "dev": "concurrently -n api,web \"node --watch server/index.js\" \"vite web\"",
    "server": "node server/index.js",
    "test": "node --test \"tests/*.test.js\"",
    "check:ui": "node scripts/check-ui.mjs",
    "verify": "node scripts/verify.mjs",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "better-sqlite3": "^12.11.1",
    "d3-sankey": "^0.12.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "plaid": "latest",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-plaid-link": "^4.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^8.2.2",
    "vite": "^8.3.1"
  },
  "engines": {
    "node": ">=22.12"
  }
}

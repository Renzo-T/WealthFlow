# Secrets: Plaid keys and the encryption key. Never commit; .env.example is the empty template.
.env
.env.*
!.env.example
*.pem
*.key

# Your financial data and backups (bank tokens are encrypted, but the data itself is private)
data/
*.db
*.db-shm
*.db-wal
*.sqlite

# Local https certificates from mkcert
certs/

# Dependencies, builds, logs
node_modules/
dist/
_tmpbuild/
*.log
.DS_Store
Thumbs.db
ui-shots/

# Downloadable build (npm run package) and the Node it bundles
release/

